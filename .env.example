# Copy this file to .env and fill in the accounts you actually use.
# The app still builds and saves the shortlist when these are blank.

# Email. Gmail example: host smtp.gmail.com, port 587, and an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# WhatsApp via Twilio. FROM looks like whatsapp:+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Used by: python run_saved.py --loop
RUN_AT=09:00
